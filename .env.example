# =============================================================================
# ENVIRONMENT
#
# Copy to `.env` and fill in. Never commit the filled `.env`.
#
# EVERY VARIABLE BELOW IS OPTIONAL. The service runs, and every number in the
# README reproduces, with an empty environment: retrieval is BM25 plus an
# offline LSA projection, and generation is deterministic extraction. No
# account, network call, GPU or API key is required at any point.
#
# The variable names here are the ones `config/settings.py` actually reads, and
# `tests/unit/test_settings.py::test_env_example_documents_exactly_the_read_keys`
# fails if this file and the code disagree. An earlier version of this file
# documented six variables that nothing parsed -- including the corpus path --
# which is worse than an absent file: a reader concludes their configuration is
# being honoured when it is being ignored.
# =============================================================================

# --- Corpus -------------------------------------------------------------------
# Directory of documents to index.
RAG_CORPUS_DIR=
# Chunking. These feed the chunk ids recorded in the corpus manifest, so
# changing either changes the manifest id without any document being edited.
RAG_MAX_CHUNK_CHARS=
RAG_CHUNK_OVERLAP=

# --- Retrieval ----------------------------------------------------------------
# In-process retrieval is the default and needs no credentials.
RAG_USE_BM25=
RAG_USE_DENSE=
RAG_BM25_K1=
RAG_BM25_B=
RAG_FUSION=
RAG_FUSION_RRF_K=
RAG_DENSE_WEIGHT=
RAG_SPARSE_WEIGHT=
RAG_CANDIDATE_K=
RAG_FINAL_K=
RAG_RERANK=
# Truncated-SVD dimension for the offline dense leg. Raising it makes the
# projection more expressive and slower; see ADR 0004.
RAG_LSA_DIM=

# --- Confidence escalation ----------------------------------------------------
# `RAG_CONFIDENCE_THRESHOLD` is the fused-score floor below which a query is
# escalated; `RAG_MAX_ESCALATIONS` caps how many times. The ablation suite shows
# escalation COSTS pass rate on the reference corpus -- it fires on
# mid-confidence queries where a second pass adds noise rather than recall. Raise
# the threshold or set RAG_ADAPTIVE=false rather than enabling it.
RAG_ADAPTIVE=
RAG_CONFIDENCE_THRESHOLD=
RAG_MAX_ESCALATIONS=

# --- Answering ----------------------------------------------------------------
# Minimum confidence to answer. Below this the system abstains rather than
# returning unverified text.
RAG_ABSTAIN_BELOW=
# Note: these two are unprefixed in `config/settings.py`, unlike every other
# retrieval variable.
MAX_CONTEXT_CHARS=
MAX_QUERY_CHARS=
MAX_CHUNKS=

# --- Status policy ------------------------------------------------------------
# Comma-separated front-matter `status` values to exclude from retrieval
# entirely. An explicitly empty value means "exclude nothing".
RAG_STATUS_EXCLUDE=
# Comma-separated values to *demote* rather than exclude, and only for queries
# that look preliminary ("draft", "proposal", "latest").
RAG_STATUS_DEMOTE=

# --- Optional: generation endpoint ---------------------------------------------
# Any endpoint speaking the OpenAI chat schema. Leave both blank for the
# deterministic extractive generator, which is the documented default.
#
# Set only LLM_BASE_URL (no key) to use a local server -- Ollama, vLLM, llama.cpp
# and LM Studio all accept unauthenticated requests, and that counts as
# "configured" so the pipeline actually calls it. Set LLM_API_KEY to reach a
# hosted vendor.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_RETRIES=
LLM_TIMEOUT_S=
# Alias, honoured only when LLM_API_KEY is unset. Prefer LLM_API_KEY.
OPENAI_API_KEY=

# --- Optional: hosted embeddings ---------------------------------------------
# Setting this switches the dense leg from offline LSA to a hosted model.
# Non-deterministic: scores will not reproduce across runs, so any published
# benchmark must state which mode produced it (ADR 0004). JINA_API_KEY is
# accepted as an alias.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_RERANK_MODEL=
EMBEDDINGS_DIM=
EMBEDDINGS_BATCH=
EMBEDDINGS_TIMEOUT_S=
# Alias, honoured only when EMBEDDINGS_API_KEY is unset. Prefer
# EMBEDDINGS_API_KEY.
JINA_API_KEY=

# --- Optional: hosted vector store --------------------------------------------
# Neither is set by default; the in-process index is used. Set exactly one.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_LOCAL_PATH=

# --- Cache --------------------------------------------------------------------
# Process-local, keyed by query and corpus manifest id, so a re-index
# invalidates it without a restart.
CACHE_ENABLED=
CACHE_MAX_ENTRIES=

# --- Cost model (reporting only, not enforcement) -----------------------------
# Only meaningful with a generation endpoint configured. Prices are per million
# tokens and are the operator's to correct for their contract.
COST_PER_MTOK_INPUT=
COST_PER_MTOK_OUTPUT=

# --- Observability ------------------------------------------------------------
# Off by default. When set to 1, spans and events are written to stderr as JSON
# lines. No exporter, no network call, no account. Read directly by
# observability/tracing.py rather than through config/settings.py.
RAG_TRACE_EMIT=

# --- API ----------------------------------------------------------------------
# Reference harness only. The tenant in a request body is NOT authenticated --
# see the security posture note in ARCHITECTURE.md.
RAG_API_KEY=
RATE_LIMIT_PER_MINUTE=
# Leave unset unless behind a trusted proxy. Trusting X-Forwarded-For from an
# untrusted hop lets a client spoof its own rate-limit bucket.
TRUST_FORWARDED_FOR=
